{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "healthcheckPath": "/api/health", "healthcheckTimeout": 180, "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10, "numReplicas": 1, "drainingSeconds": 30
  }
}
